# Copy to .env and fill in real values before running in anything but local dev.
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string

# Path to the Google service account JSON key used for read-only Drive
# access (see README's "Google Drive API setup" section). Required for
# Phase 2 ingestion to work; /admin folder intake (Phase 1) works without it.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

