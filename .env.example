# Copy to .env and fill in real values before running in anything but local dev.
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string

# Path to the Google service account JSON key used for read-only Drive
# access (see README's "Google Drive API setup" section). Required for
# Phase 2 ingestion to work; /admin folder intake (Phase 1) works without it.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Optional DBSCAN tuning for Phase 3 clustering (defaults shown).
# CLUSTER_EPS=0.5
# CLUSTER_MIN_SAMPLES=2

# Optional Phase 7 §4 face detection/embedding tuning (defaults shown).
# FACE_MODEL_PACK is the insightface model pack (SCRFD detector +
# ArcFace-class 512-d recognition model); FACE_DET_SIZE/FACE_DET_THRESH
# tune the detector; FACE_CTX_ID is -1 for CPU or a GPU device index.
# FACE_MODEL_PACK=buffalo_l
# FACE_DET_SIZE=640
# FACE_DET_THRESH=0.5
# FACE_CTX_ID=-1

# Phase 7 §6: Postgres + pgvector, standing up alongside SQLite -- not
# used by the live app yet (see app/database_pg.py's module docstring
# and scripts/migrate_to_postgres.py). Needs the `vector` extension
# available on the target Postgres (CREATE EXTENSION vector;).
# DATABASE_URL=postgresql://user:password@host:5432/church_photos
# EMBEDDING_DIM=512
# (EMBEDDING_DIM must match whatever face_processing.py currently
# produces -- 512 now that Phase 7 §4's model swap has shipped. Existing
# 128-d embeddings in the SQLite library predate this and are NOT
# comparable to new ones -- see face_processing.py's module docstring
# and re-run ingestion/re-embedding before trusting matching or
# re-running the Postgres migration.)

# Phase 7 §9: durable ingestion queue (Redis + RQ). "Process folder" in
# the admin panel enqueues a job here; nothing actually runs it without
# a separate `rq worker ingestion --url $REDIS_URL` process also
# running -- see README's "Running the ingestion worker" section.
# REDIS_URL=redis://localhost:6379/0

# Optional: max seconds a single folder's ingestion job may run before
# RQ kills it as timed out. Default (shown) is 6 hours; a deployment
# with very large folders may need more, one with small folders may
# want less so a truly-stuck job fails fast instead of blocking that
# folder's job id for hours.
# INGEST_JOB_TIMEOUT_SECONDS=21600

# Phase 7 §10: S3-compatible object storage for the thumbnail caches
# (data/thumb_cache/, data/face_thumb_cache/). Optional -- unset means
# those caches stay exactly on local disk, same as before this piece
# existed. Set S3_BUCKET (and S3_ENDPOINT_URL for anything that isn't
# AWS S3 itself -- MinIO, Cloudflare R2, Backblaze B2, DigitalOcean
# Spaces, ...) to share thumbnail caching across app instances and
# survive redeploys on a platform with an ephemeral local filesystem.
# Credentials are read via boto3's normal chain (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials, an instance role,
# etc.) -- there's deliberately no S3_ACCESS_KEY_ID here, to avoid a
# second, easy-to-forget-to-rotate place credentials could live.
# S3_BUCKET=church-photo-finder-thumbs
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_KEY_PREFIX=
